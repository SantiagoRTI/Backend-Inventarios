							"raw": "{{base_url}}/inventarios/validar/INV-BN-2026",
							"host": ["{{base_url}}"],
							"path": ["inventarios", "validar", "INV-BN-2026"]
						},
						"description": "Valida que un inventario existe (usado por inspectores)"
					},
					"response": []
				}
			]
		},
