					"response": []
				},
				{
					"name": "Cambiar Contraseña",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"contrasenaActual\": \"Inspector123!\",\n    \"contrasenaNueva\": \"NuevaContrasena123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/usuarios/2/cambiar-contrasena",
							"host": ["{{base_url}}"],
							"path": ["usuarios", "2", "cambiar-contrasena"]
						},
						"description": "Cambia la contraseña de un usuario (requiere contraseña actual para validación)"
					},
					"response": []
				},
				{
					"name": "Eliminar Usuario",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/usuarios/3",
							"host": ["{{base_url}}"],
							"path": ["usuarios", "3"]
						},
						"description": "Desactiva un usuario del sistema"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Inventarios",
			"item": [
				{
					"name": "Listar Inventarios",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/inventarios",
							"host": ["{{base_url}}"],
							"path": ["inventarios"]
						},
						"description": "Obtiene todos los inventarios"
					},
					"response": []
				},
				{
					"name": "Crear Inventario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('inventario_id', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Inventario Bulevar Niza 2026\",\n    \"codigo\": \"INV-BN-2026\",\n    \"estado\": \"Ejecucion\",\n    \"inspectorId\": 2,\n    \"centroCostosId\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/inventarios",
							"host": ["{{base_url}}"],
							"path": ["inventarios"]
						},
						"description": "Crea un nuevo inventario"
