{
	"info": {
		"_postman_id": "inventarios-rti-collection",
		"name": "Inventarios RTI API",
		"description": "Colección de peticiones para probar la API REST de Inventarios RTI.\n\nIncluye endpoints para:\n- Autenticación JWT\n- Gestión de usuarios\n- Gestión de inventarios\n- Carga de activos desde Excel\n- Registro de activos por inspectores\n- Cruce de información\n- Generación de reportes en Excel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8050/api",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "Login Administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    pm.environment.set('jwt_token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuario\": \"admin@rti.com.co\",\n    \"contraseña\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Autentica un usuario administrador y obtiene el token JWT"
					},
					"response": []
				},
				{
					"name": "Login Inspector",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    pm.environment.set('jwt_token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuario\": \"carlos.jimenez@rti.com.co\",\n    \"contraseña\": \"Inspector123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Autentica un usuario inspector y obtiene el token JWT"
					},
					"response": []
				}
			]
		},
		{
